+static inline unsigned consume_stream_event_without_restarting_audio(
+    chanend ?c_aud,
+    unsigned command)
+{
+    if(command == XUA_AUD_SET_AUDIO_START)
+    {
+        inuint(c_aud); /* DSD mode; unused by this capture-only application. */
+        inuint(c_aud); /* Output resolution; there are no output channels. */
+        outct(c_aud, XS1_CT_END);
+        return XUA_AUDCTL_NO_COMMAND;
+    }
+    else if(command == XUA_AUD_SET_AUDIO_STOP)
+    {
+        outct(c_aud, XS1_CT_END);
+        return XUA_AUDCTL_NO_COMMAND;
+    }
+
+    return command;
+}
